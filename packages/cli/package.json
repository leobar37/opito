{
  "name": "@opito/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "opito": "./dist/cli.js",
    "opito-dev": "./bin/opito-dev.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
