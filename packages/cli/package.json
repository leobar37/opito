{
  "name": "opito",
  "version": "1.0.0",
  "description": "CLI sync tool for Claude Code, OpenCode, Droid, and Codex",
  "type": "module",
  "bin": {
    "opito": "./dist/cli.js",
    "opito-dev": "./bin/opito-dev.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@opentui/core": "^0.1.86",
    "cac": "^6.7.14",
    "chokidar": "^5.0.0",
    "picocolors": "^1.1.1",
    "picospinner": "^3.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "claude",
    "opencode",
    "droid",
    "codex",
    "sync",
    "cli",
    "ai",
    "agents",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/opito.git",
    "directory": "packages/cli"
  }
}
