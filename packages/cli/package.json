    "@opito/plugins": "workspace:*",
    "@clack/prompts": "^1.0.1",
    "@opentui/core": "^0.1.86",
    "cac": "^6.7.14",
    "chokidar": "^5.0.0",
    "picocolors": "^1.1.1",
    "picospinner": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
