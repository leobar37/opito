{
  "name": "@opito/opencode-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "OpenCode plugin development toolkit with Effect-TS integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && pnpm build:flat",
    "build:flat": "node scripts/build-flat.mjs",
    "dev": "tsc --watch & node scripts/watch.mjs",
    "clean": "rm -rf dist flat",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests yet'"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.33",
    "@opencode-ai/sdk": "^1.14.33",
    "effect": "^3.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "effect-ts",
    "ai",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/opito",
    "directory": "packages/opencode-plugin"
  }
}
